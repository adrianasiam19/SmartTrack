# ─── Database ─────────────────────────────────────────────────────────────────
# Get this from Neon Dashboard → your project → Connection string
DATABASE_URL=postgresql://neondb_owner:npg_2RcWpCYgazL9@ep-cool-truth-aiy3abdl-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/
# Authorized redirect URI must exactly match:
#   http://localhost:3000/auth/callback
# (plus your production frontend URL/auth/callback when deployed)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email / Password Reset (optional) ────────────────────────────────────────
# When SMTP is unset, development mode logs the reset link and may return
# `dev_reset_link` from POST /auth/forgot-password for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=noreply@atlas.app

# ─── App ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your Next.js frontend URL)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Environment: development | production
ENVIRONMENT=development
