# ─── Database ─────────────────────────────────────────────────────────────────
# Local development (PostgreSQL on your machine):
DATABASE_URL=postgresql+psycopg://atlas:atlas_local_dev@127.0.0.1:5432/atlas
# Neon / production example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI must exactly match your frontend callback, e.g.:
#   http://localhost:3000/auth/callback
#   https://YOUR_FRONTEND/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email / Password Reset (Resend) ──────────────────────────────────────────
# From https://resend.com/api-keys — never expose to the browser (no NEXT_PUBLIC_).
# Required when ENVIRONMENT=production (app refuses to start if missing).
RESEND_API_KEY=
# Verified sender, e.g. Atlas <onboarding@resend.dev> (dev) or Atlas <noreply@yourdomain.com>
MAIL_FROM=

# ─── App ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your Next.js frontend URL)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# Used to build password-reset links — never hardcode localhost in code paths
FRONTEND_URL=http://localhost:3000

# Environment: development | production
ENVIRONMENT=development \


# ─── ML alternate recommendations (never primary) ─────────────────────────────
# Primary list is always KNUST cut-offs + aggregate. ML only adds an alternate panel.
ML_RECOMMENDATIONS_ENABLED=true
ML_RECOMMENDATIONS_TOP_N=8
# Legacy aliases (optional)
ML_ALTERNATE_ENABLED=true
ML_ALTERNATE_TOP_N=5
# Attach recommendation debug payload + enable /recommendations/self-test
# (also auto-enabled when ENVIRONMENT=development)
RECOMMENDATION_DEBUG=false

# ─── Educational media (optional) ─────────────────────────────────────────────
PIXABAY_API_KEY=
# YouTube Data API v3 key — preferred for Learning Center video recommendations.
# Without it, Atlas falls back to a public search provider when available.
YOUTUBE_API_KEY=
EDUCATIONAL_VIDEOS_ENABLED=true
# Challenge images: local_only (default, fast) | off | full (live search, slower)
CHALLENGE_IMAGES_MODE=local_only

# ─── LLM (optional) ───────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
